# RPC de Sepolia (Alchemy, Infura, o similar)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/TU_API_KEY

# Clave privada de la cuenta que despliega (con fondos de Sepolia ETH). Incluir el prefijo 0x
PRIVATE_KEY=0xTU_CLAVE_PRIVADA

# API key de Etherscan, para verificar el contrato automáticamente tras el despliegue
ETHERSCAN_API_KEY=TU_ETHERSCAN_API_KEY
